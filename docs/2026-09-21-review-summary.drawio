<mxGraphModel page="1" pageWidth="1080" pageHeight="660" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="IdeaCard：下一版，重点改这 4 件事" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;text;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="20" width="1010" height="50" /></mxCell><mxCell id="sub" value="目标：资料存得放心，读得舒服，最后能变成自己的想法。" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;text;align=left;fontSize=19;fontColor=#58655C;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="75" width="1000" height="32" /></mxCell><mxCell id="h0" value="优化方向" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;text;fontSize=17;fontColor=#657169;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="127" width="168" height="30" /></mxCell><mxCell id="h1" value="怎么改" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;text;fontSize=17;fontColor=#657169;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="127" width="420" height="30" /></mxCell><mxCell id="h2" value="你能得到什么" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;text;fontSize=17;fontColor=#657169;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="127" width="330" height="30" /></mxCell><mxCell id="a0" value="先补可靠性" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#284831;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="174" width="168" height="86" /></mxCell><mxCell id="b0" value="加载失败不覆盖原文&lt;br&gt;AI 用最新内容，逐步补上备份" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#F3F6F4;strokeColor=none;fontSize=19;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="174" width="420" height="86" /></mxCell><mxCell id="c0" value="少担心资料丢失&lt;br&gt;AI 不再拿旧内容回答" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#E5F0E8;strokeColor=none;fontSize=21;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="174" width="330" height="86" /></mxCell><mxCell id="e0" edge="1" parent="1" source="b0" target="c0" style="html=1;endArrow=block;endFill=1;strokeColor=#72907A;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="a1" value="阅读更舒服" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#284831;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="282" width="168" height="86" /></mxCell><mxCell id="b1" value="正文可展开，减少重复标题&lt;br&gt;AI 输出时，不把你强拉到底部" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#F3F6F4;strokeColor=none;fontSize=19;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="282" width="420" height="86" /></mxCell><mxCell id="c1" value="长文看得完整&lt;br&gt;边读边聊，不被打断" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#E5F0E8;strokeColor=none;fontSize=21;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="282" width="330" height="86" /></mxCell><mxCell id="e1" edge="1" parent="1" source="b1" target="c1" style="html=1;endArrow=block;endFill=1;strokeColor=#72907A;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="a2" value="整理更省事" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#284831;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="390" width="168" height="86" /></mxCell><mxCell id="b2" value="筛出“待整理”，搜索显示匹配片段&lt;br&gt;用快捷键切换卡片" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#F3F6F4;strokeColor=none;fontSize=19;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="390" width="420" height="86" /></mxCell><mxCell id="c2" value="知道下一张处理什么&lt;br&gt;找旧资料少翻几遍" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#E5F0E8;strokeColor=none;fontSize=21;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="390" width="330" height="86" /></mxCell><mxCell id="e2" edge="1" parent="1" source="b2" target="c2" style="html=1;endArrow=block;endFill=1;strokeColor=#72907A;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="a3" value="讨论能留下" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#284831;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="498" width="168" height="86" /></mxCell><mxCell id="b3" value="停止后保留已生成的回答&lt;br&gt;选中有用内容，追加到“我的想法”" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#F3F6F4;strokeColor=none;fontSize=19;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="498" width="420" height="86" /></mxCell><mxCell id="c3" value="聊完就能留下结论&lt;br&gt;少做复制粘贴" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;rounded=1;arcSize=12;fillColor=#E5F0E8;strokeColor=none;fontSize=21;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="498" width="330" height="86" /></mxCell><mxCell id="e3" edge="1" parent="1" source="b3" target="c3" style="html=1;endArrow=block;endFill=1;strokeColor=#72907A;strokeWidth=2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="foot" value="推荐顺序：先保可靠 → 再优化阅读与整理 → 最后补齐内容沉淀" style="html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontColor=#273129;text;align=left;fontSize=18;fontColor=#486651;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="614" width="1010" height="32" /></mxCell></root></mxGraphModel>