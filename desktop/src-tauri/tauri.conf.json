{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdeaCard",
  "version": "0.1.0",
  "identifier": "com.niedawu.ideacard",
  "build": {
    "beforeDevCommand": "npm run build:native && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:native && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IdeaCard",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ideacard-native"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "IdeaCard Local Signing"
    }
  }
}
